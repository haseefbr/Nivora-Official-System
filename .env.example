APP_SECRET=change-me-to-a-long-random-string
# Development convenience: false in production
DEV_MODE=true
FORCE_HTTPS=false
SESSION_SECURE=false
PUBLIC_BASE_URL=http://localhost:8000
# Database
DATABASE_PATH=data/nivora.db
LOG_PATH=data/nivora.log
# Model provider (never commit real keys)
AI_ENABLED=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gigalab-local
FALLBACK_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# When no model answers, read the message with local rules (dev only)
AI_LOCAL_FALLBACK=true
AI_TIMEOUT_SECONDS=20
AI_TOTAL_DEADLINE_SECONDS=60
AI_BUDGET_RM_MONTH=1000.00
# Limits
MAX_INPUT_CHARS=4000
RATE_PERSON_PER_MINUTE=10
RATE_TENANT_PER_DAY=56
# Sign-in, messages and billing
EMAIL_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMS_API_KEY=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_TEST_MODE=true
# Chatbot (Flowise agent flow). Leave FLOWISE_URL empty to switch the assistant off.
BOT_ENABLED=true
FLOWISE_URL=
FLOWISE_API_KEY=
FLOWISE_TIMEOUT_SECONDS=35
